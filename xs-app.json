{
  "welcomeFile": "/index.html",
  "authenticationMethod": "route",
  "logout": {
    "logoutEndpoint": "/do/logout",
    "logoutPage": "/logout.html"
  },
  "routes": [
    {
      "source": "^/api/(.*)$",
      "target": "/$1",
      "destination": "procurement-backend",
      "authenticationType": "xsuaa",
      "csrfProtection": true,
      "scope": "$XSAPPNAME.Display"
    },
    {
      "source": "^/odata/(.*)$",
      "target": "/odata/$1",
      "destination": "procurement-cap-srv",
      "authenticationType": "xsuaa",
      "csrfProtection": true
    },
    {
      "source": "^/admin/(.*)$",
      "target": "/$1",
      "destination": "procurement-backend",
      "authenticationType": "xsuaa",
      "scope": "$XSAPPNAME.Admin"
    },
    {
      "source": "^/public/(.*)$",
      "localDir": "resources",
      "authenticationType": "none"
    },
    {
      "source": "^(.*)$",
      "localDir": "webapp",
      "authenticationType": "xsuaa"
    }
  ]
}